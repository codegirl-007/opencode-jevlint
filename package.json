{
  "name": "opencode-jevlint",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "OpenCode V2 plugin that wraps the jevlint CLI: an on-demand jevlint_check tool plus bounded auto-checks after edits.",
  "license": "MIT",
  "author": "codegirl-007",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codegirl-007/opencode-jevlint.git"
  },
  "homepage": "https://github.com/codegirl-007/opencode-jevlint#readme",
  "bugs": {
    "url": "https://github.com/codegirl-007/opencode-jevlint/issues"
  },
  "types": "./src/index.ts",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "jevlint",
    "lint",
    "tree-sitter"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
